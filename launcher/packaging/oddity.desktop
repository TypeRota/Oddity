[Desktop Entry]
Type=Application
Version=1.0
Name=Oddity
GenericName=Game Launcher
GenericName[zh_CN]=游戏启动器
Comment=Native Linux launcher for Neverness To Everness
Comment[zh_CN]=《异环》Linux 原生启动器
Exec=oddity
TryExec=oddity
Icon=oddity
Terminal=false
Categories=Game;Utility;
Keywords=game;launcher;NTE;异环;
StartupNotify=true
StartupWMClass=oddity
X-KDE-StartupWMClass=oddity
Actions=LaunchCn;LaunchGlobal;XWayland;Recovery;

[Desktop Action LaunchCn]
Name=异环
Name[zh_CN]=异环
Exec=oddity --launch --game nte --region cn --launch-mode background
Icon=oddity

[Desktop Action LaunchGlobal]
Name=NTE
Name[zh_CN]=NTE
Exec=oddity --launch --game nte --region global --launch-mode background
Icon=oddity

[Desktop Action XWayland]
Name=XWayland 模式
Name[zh_CN]=XWayland 模式
Exec=oddity --xwayland
Icon=oddity

[Desktop Action Recovery]
Name=Emergency Recovery
Name[zh_CN]=应急恢复
Exec=oddity --recovery
