#!/bin/sh
# 仓库自带钩子: 作者与提交者必须是仓库配置的身份.
#
# git -c user.name=... 会通过 GIT_CONFIG_PARAMETERS 泄漏进钩子里的 git config 读取,
# 因此这里剥掉它再读一次, 才能拿到真正配置的身份.
set -e

clean_name=$(env -u GIT_CONFIG_PARAMETERS -u GIT_CONFIG_COUNT git config user.name 2>/dev/null || true)
clean_email=$(env -u GIT_CONFIG_PARAMETERS -u GIT_CONFIG_COUNT git config user.email 2>/dev/null || true)
if [ -z "$clean_name" ] || [ -z "$clean_email" ]; then
  exit 0
fi

actual_name=${GIT_AUTHOR_NAME:-$clean_name}
actual_email=${GIT_AUTHOR_EMAIL:-$clean_email}

if [ "$actual_name" != "$clean_name" ] || [ "$actual_email" != "$clean_email" ]; then
  echo "hooks: 作者身份与仓库配置不一致, 已拒绝提交." >&2
  echo "  配置: $clean_name <$clean_email>" >&2
  echo "  本次: $actual_name <$actual_email>" >&2
  echo "  不要用 -c user.name/-c user.email/--author 覆盖身份." >&2
  exit 1
fi

if [ -n "${GIT_COMMITTER_NAME:-}" ] || [ -n "${GIT_COMMITTER_EMAIL:-}" ]; then
  committer_name=${GIT_COMMITTER_NAME:-$clean_name}
  committer_email=${GIT_COMMITTER_EMAIL:-$clean_email}
  if [ "$committer_name" != "$clean_name" ] || [ "$committer_email" != "$clean_email" ]; then
    echo "hooks: 提交者身份与仓库配置不一致, 已拒绝提交." >&2
    echo "  配置: $clean_name <$clean_email>" >&2
    echo "  本次: $committer_name <$committer_email>" >&2
    exit 1
  fi
fi

exit 0
